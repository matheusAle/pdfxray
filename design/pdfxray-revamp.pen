                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "• Name first (Inter 12 semibold #E7EAEE) · key (JetBrains Mono 10 #6B7380) · one-line description (Inter 11 #A2AAB6), max width 260.",
                      "lineHeight": 1.45,
                      "fontFamily": "Inter",

                {
                  "type": "text",
                  "id": "wrOp7",
                  "name": "B",
                  "fill": "#A2AAB6",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "X-ray outlines at 50% (full on hover and selection); the legend is a '4 kinds ▾' chip; the stepper only while Paint order is on. Floating cards anchor to the canvas's top-right margin, 14 px in, never over the page; on narrow windows they collapse to chips.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {

                        0,
                        7
                      ],
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "icon",
                          "id": "oVkLf",
                          "name": "Icon",
                          "width": 14,
                          "height": 14,
                          "icon": "scan",
                          "library": "lucide",
                          "fill": "#3DD6F5"
                        },
                        {
                          "type": "text",

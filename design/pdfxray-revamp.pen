        {
          "type": "frame",
          "id": "f75ra9",
          "name": "Usage",
          "width": 1600,
          "layout": "vertical",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "GNyZq",
              "name": "Rule",
              "fill": "#A9B1BC",
              "textGrowth": "fixed-width",
              "width": 1600,
              "content": "• Mark: a document split by a scan line. Left: the page as readers see it (solid). Right: the x-ray glass in the accent #3DD6F5 with grid and faint lines; folded corner; scan line #E8FCFF with an accent glow.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "TrBLi",
              "name": "Rule",
              "fill": "#A9B1BC",
              "textGrowth": "fixed-width",
              "width": 1600,
              "content": "• Small (≤ 48 px): no grid, glow or faint lines; light page + solid accent half, three thick lines, white scan line. Mono glyph for one-colour uses.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "owXTB",
              "name": "Rule",
              "fill": "#A9B1BC",
              "textGrowth": "fixed-width",
              "width": 1600,
              "content": "• Tile: #1F242C → #08090C, radius 22.5%, hairline #FFFFFF14. The mark is 62% of the tile height, centred.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "xhg5L",
              "name": "Rule",
              "fill": "#A9B1BC",
              "textGrowth": "fixed-width",
              "width": 1600,
              "content": "• Wordmark: Inter SemiBold, tight (−3.5%). “pdf” in text colour, “xray” in #3DD6F5 on dark and #0E8FAE on light backgrounds (accent is too faint for text on white).",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },

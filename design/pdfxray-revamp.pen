                  "fill": "#A2AAB6",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Collapsed to a 34 px tab strip by default; it expands on page click (hit stack), when validation finishes, or when a tab is clicked. Counts in colour only for warnings and errors.",
                  "lineHeight": 1.5,
                  "fontFamily": "Inter",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            }

                  "width": 300,
                  "height": 420,
                  "fill": "$surface",
                  "cornerRadius": 8,
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "layout": "none",
                  "children": [
                    {
                      "type": "frame",
                      "id": "GEWfX",
                      "x": 16,
                      "y": 16,
                      "name": "X-ray button",
                      "height": 28,
                      "fill": "#3DD6F51F",
                      "cornerRadius": 6,
                      "stroke": "#3DD6F5",
                      "strokeWidth": 1,
                      "gap": 3,
                      "padding": [
                        0,
